{
  "manifest_version": 3,
  "name": "NYSCEF Name Search Batch",
  "version": "0.3.0",
  "description": "Search NYSCEF Case Search (by name) from a highlighted Google Sheets cell, or batch from a public sheet URL. Writes the result link into the cell below.",
  "permissions": ["tabs", "scripting", "storage", "clipboardWrite", "clipboardRead"],
  "host_permissions": [
    "https://iapps.courts.state.ny.us/*",
    "https://docs.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "NYSCEF Name Search Batch",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://iapps.courts.state.ny.us/nyscef/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://docs.google.com/spreadsheets/*"],
      "js": ["sheets.js"],
      "run_at": "document_idle"
    }
  ]
}
